{
  "name": "@real-limitless/skill-flow",
  "version": "0.1.0",
  "description": "Agent Skills catalog + install plane \u2014 search, audit, and install SKILL.md packages into any harness",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "skill-flow": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:ui",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "catalog:seed": "tsx scripts/catalog/seed.ts",
    "catalog:validate": "tsx scripts/catalog/validate.ts",
    "site:build": "tsx scripts/site/build-pages.ts",
    "site:preview": "npm run catalog:seed && SITE_BASE= npm run site:build && npx --yes serve site/out -p 4173 --config site/serve.json",
    "campaign:capture": "bash docs/campaign/capture.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.1",
    "hono": "^4.13.1",
    "undici": "^6.21.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "fast-uri": "^3.1.6"
  }
}

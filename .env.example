# Optional: raise GitHub API rate limits for factory scrape
# GITHUB_TOKEN=

# HTTP listen port inside the container (compose does not publish a host port)
# SKILL_FLOW_PORT=8788
# SKILL_FLOW_HOST=0.0.0.0

# Override skill-flow home (compose sets this to /data)
# SKILL_FLOW_HOME=

# Operator control sqlite (default: $SKILL_FLOW_HOME/control.sqlite)
# SKILL_FLOW_DB_PATH=

# Break-glass Bearer for /v1 and HTTP /mcp, and the first-operator setup token.
# When set, POST /v1/auth/setup must present this value. When unset outside
# development, setup is refused. Not the browser login password.
# SKILL_FLOW_ADMIN_TOKEN=

# development or production. When unset, only NODE_ENV=production is treated
# as a non-development environment. Stdout audit logs use this value.
# SKILL_FLOW_ENV=development

# Trust CF-Connecting-IP and X-Forwarded-For, and X-Forwarded-Proto for HSTS.
# Leave unset unless the process is behind a proxy you control. Any other value is off.
# SKILL_FLOW_TRUSTED_PROXY=true

# Comma-separated browser origins allowed to call the API cross-origin.
# Default is same-origin only. `*` is not accepted.
# SKILL_FLOW_CORS_ORIGINS=

# Login and setup failure lockout (in-memory, per IP and per account).
# SKILL_FLOW_AUTH_MAX_ATTEMPTS=10
# SKILL_FLOW_AUTH_WINDOW_SEC=900
# SKILL_FLOW_AUTH_LOCKOUT_SEC=900

# Extra allowlisted roots for local paths on /v1/installs and /v1/audit.
# Path-delimiter separated. SKILL_FLOW_HOME and the catalog directory are always included.
# SKILL_FLOW_PATH_ROOTS=

# Override catalog directory (default: <repo>/catalog or SKILL_FLOW_HOME/catalog)
# SKILL_FLOW_CATALOG_DIR=

# Project root for project-scoped installs (default: cwd)
# SKILL_FLOW_PROJECT_ROOT=

# One Docker host, two stacks: set a distinct project name and image tag per
# environment. Do not add container_name. Compose does not bind host port 8788;
# the app is reachable on 8788 inside the compose network (Traefik).
# COMPOSE_PROJECT_NAME=skill-flow-dev
# SKILL_FLOW_IMAGE=skill-flow:dev

# Optional: raise GitHub API rate limits for factory scrape
# GITHUB_TOKEN=

# SKILL_FLOW_PORT=8788
# Override skill-flow home (default: ~/.skill-flow)
# SKILL_FLOW_HOME=

# Override catalog directory (default: <repo>/catalog or SKILL_FLOW_HOME/catalog)
# SKILL_FLOW_CATALOG_DIR=

# Project root for project-scoped installs (default: cwd)
# SKILL_FLOW_PROJECT_ROOT=
